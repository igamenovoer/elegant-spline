{
  "name": "elegant-spline-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun build ./index.html --minify --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test ./tests/unit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.2",
    "@types/d3-selection": "3.0.13",
    "@types/d3-zoom": "3.0.9",
    "typescript": "5.9.3"
  }
}
